};
const RARITY_ORDER = ['common', 'rare', 'epic', 'legendary', 'rainbow'];
const RARITY_LABEL = { common: 'Обычная', rare: 'Редкая', epic: 'Эпическая', legendary: 'Легендарная', rainbow: 'Радужная' };
const RARITY_ICON = { common: '📦', rare: '🎁', epic: '💎', legendary: '👑', rainbow: '🌈' };

const CASES = [
  { id: 'common', name: 'Обычный кейс', icon: '📦', cost: 60,
    weights: { common: 70, rare: 25, epic: 5 } },
  { id: 'rare', name: 'Редкий кейс', icon: '🎁', cost: 180,
    weights: { common: 30, rare: 45, epic: 20, legendary: 5 } },
  { id: 'epic', name: 'Эпический кейс', icon: '💎', cost: 450,
    weights: { rare: 30, epic: 45, legendary: 20, rainbow: 5 } },
];

function skinsOfRarity(r) { return Object.keys(SKINS).filter(k => SKINS[k].rarity === r); }

function rollCase(caseDef) {
  const entries = Object.entries(caseDef.weights);
  const total = entries.reduce((s, [, w]) => s + w, 0);
  let roll = Math.random() * total;
  let rarity = entries[0][0];
  for (const [r, w] of entries) {
    if (roll < w) { rarity = r; break; }
    roll -= w;
  }
  const pool = skinsOfRarity(rarity);
  const skinId = pool[Math.floor(Math.random() * pool.length)];
  return skinId;
}

/* ---------------------------------------------------------
   PIXEL SPRITES
--------------------------------------------------------- */
// 9 wide x 13 tall pineapple grid
const PINEAPPLE_GRID = [
  '.L.LL.L..',
  '.LLLLLLL.',
  '..L.L.L..',
  'OOOOOOOO.',
  'OYyYyYyO.',
  'OyYyYyYO.',
  'OKKKKKKO.',
  'OKWKKWKO.',
  'OYyYyYyO.',
  'OyYyYyYO.',
  'OYyYyYyO.',
  'OOOOOOOO.',
  '..OOOO...',
];

function palettePineapple(elite) {
  return elite
    ? { L: '#3a1a66', l: '#6a2fae', O: '#3a0a4a', Y: '#c26bff', y: '#e6b3ff', K: '#160016', W: '#ffffff' }
    : { L: '#2d6a1f', l: '#4c9a2a', O: '#7a4a12', Y: '#f7c948', y: '#ffe27a', K: '#111111', W: '#ffffff' };
}

function drawGridSprite(grid, palette, x, y, px, opts = {}) {
  const rows = grid.length;
  const cols = grid[0].length;
  const totalW = cols * px, totalH = rows * px;
  const ox = x - totalW / 2, oy = y - totalH / 2;
  for (let r = 0; r < rows; r++) {
    const row = grid[r];
    for (let c = 0; c < cols; c++) {
      const ch = row[c];
      if (ch === '.') continue;
      let color = palette[ch];
      if (!color) continue;
      if (opts.tint) color = opts.tint;
      ctx.fillStyle = color;
      ctx.fillRect(Math.round(ox + c * px), Math.round(oy + r * px), px, px);
    }
  }
  return { w: totalW, h: totalH };
}

function drawPineapple(x, y, scale, elite, hitFlash) {
  const px = scale;
  const pal = palettePineapple(elite);
  drawGridSprite(PINEAPPLE_GRID, pal, x, y, px, hitFlash ? { tint: '#ffffff' } : {});
  if (elite) {
    ctx.save();
    ctx.globalAlpha = 0.35 + 0.25 * Math.sin(performance.now() / 120);
    ctx.fillStyle = '#e6b3ff';
    ctx.beginPath();
    ctx.arc(x, y, px * 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
}

function drawBoss(boss) {
  const px = boss.w / 9;
  const pal = {
    L: boss.phase >= 3 ? '#661111' : '#2d6a1f',
    l: boss.phase >= 3 ? '#992222' : '#4c9a2a',
    O: '#5a2a08', Y: boss.hitFlash > 0 ? '#ffffff' : '#f7c948',
    y: boss.hitFlash > 0 ? '#ffffff' : '#ffe27a',
    K: '#111111', W: boss.phase >= 2 ? '#ff4444' : '#ffffff',
  };
  drawGridSprite(PINEAPPLE_GRID, pal, boss.x, boss.y, px);
  // angry eyebrows in later phases
  if (boss.phase >= 2) {
    ctx.fillStyle = '#ff2222';
    ctx.fillRect(boss.x - px * 3.2, boss.y - px * 2.6, px * 2.2, px * 0.7);
    ctx.fillRect(boss.x + px * 1.0, boss.y - px * 2.6, px * 2.2, px * 0.7);
  }
}

function drawBasket(x, y, w, h, skinId, t) {
  const skin = SKINS[skinId] || SKINS.default;
  let [c1, c2, c3] = skin.colors === 'rainbow'
    ? rainbowColors(t)
    : skin.colors;
  const px = w / 8;
  // rim
  ctx.fillStyle = c1;
  ctx.fillRect(x - w / 2, y - h / 2, w, px * 1.4);
  // body
  ctx.fillStyle = c2;
  ctx.fillRect(x - w / 2 + px * 0.6, y - h / 2 + px * 1.4, w - px * 1.2, h - px * 1.6);
  // weave lines
  ctx.fillStyle = c3;
  for (let i = 0; i < 3; i++) {
    ctx.fillRect(x - w / 2 + px * 0.6, y - h / 2 + px * (2.2 + i * 1.5), w - px * 1.2, px * 0.5);
  }
  // shine highlight
  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.fillRect(x - w / 2 + px * 0.8, y - h / 2 + px * 0.2, px * 1.5, px * 0.6);
}

function rainbowColors(t) {
  const h1 = (t * 60) % 360, h2 = (h1 + 40) % 360, h3 = (h1 + 80) % 360;
  return [`hsl(${h1},90%,55%)`, `hsl(${h2},90%,35%)`, `hsl(${h3},95%,75%)`];
}


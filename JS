/* =========================================================
   🍍 PINEAPPLE ARCADE — game.js
   Pixel-art canvas game: catch pineapples, fight the boss,
   collect skins in the shop. Pure vanilla JS + Canvas2D.
   ========================================================= */

(() => {
'use strict';

/* ---------------------------------------------------------
   CONSTANTS
--------------------------------------------------------- */
const W = 160, H = 240;               // internal pixel resolution
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
ctx.imageSmoothingEnabled = false;

const GROUND_Y = H - 14;

/* ---------------------------------------------------------
   AUDIO (synth, no external files)
--------------------------------------------------------- */
const Audio_ = (() => {
  let actx = null;
  let muted = false;
  let musicTimer = null;
  let musicStep = 0;

  function ctxReady() {
    if (!actx) {
      try { actx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { actx = null; }
    }
    if (actx && actx.state === 'suspended') actx.resume();
    return actx;
  }

  function tone(freq, dur, type = 'square', vol = 0.15, delay = 0) {
    const ac = ctxReady();
    if (!ac || muted) return;
    const t0 = ac.currentTime + delay;
    const osc = ac.createOscillator();
    const gain = ac.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, t0);
    gain.gain.setValueAtTime(vol, t0);
    gain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(gain).connect(ac.destination);
    osc.start(t0);
    osc.stop(t0 + dur + 0.02);
  }

  function sweep(f1, f2, dur, type = 'sawtooth', vol = 0.15) {
    const ac = ctxReady();
    if (!ac || muted) return;
    const t0 = ac.currentTime;
    const osc = ac.createOscillator();
    const gain = ac.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(f1, t0);
    osc.frequency.exponentialRampToValueAtTime(Math.max(f2, 1), t0 + dur);
    gain.gain.setValueAtTime(vol, t0);
    gain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(gain).connect(ac.destination);
    osc.start(t0);
    osc.stop(t0 + dur + 0.02);
  }

  function noise(dur = 0.3, vol = 0.2) {
    const ac = ctxReady();
    if (!ac || muted) return;
    const bufSize = ac.sampleRate * dur;
    const buf = ac.createBuffer(1, bufSize, ac.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) {
      data[i] = (Math.random() * 2 - 1) * (1 - i / bufSize);
    }
    const src = ac.createBufferSource();
    src.buffer = buf;
    const filt = ac.createBiquadFilter();
    filt.type = 'lowpass';
    filt.frequency.value = 1800;
    const gain = ac.createGain();
    gain.gain.setValueAtTime(vol, ac.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + dur);
    src.connect(filt).connect(gain).connect(ac.destination);
    src.start();
  }

  const sfx = {
    catch: () => tone(660, 0.09, 'square', 0.12),
    eliteCatch: () => { tone(760, 0.07, 'square', 0.12); tone(980, 0.09, 'square', 0.1, 0.05); },
    miss: () => tone(140, 0.25, 'sawtooth', 0.15),
    shot: () => tone(320, 0.06, 'square', 0.06),
    bigShot: () => { tone(180, 0.12, 'sawtooth', 0.14); noise(0.1, 0.08); },
    explosion: () => { noise(0.35, 0.25); sweep(300, 40, 0.35, 'sawtooth', 0.15); },
    powerup: () => { tone(500, 0.08, 'triangle', 0.14); tone(800, 0.1, 'triangle', 0.12, 0.08); },
    shield: () => tone(900, 0.15, 'sine', 0.1),
    bossHit: () => tone(220, 0.06, 'square', 0.1),
    bossRoar: () => { sweep(180, 60, 0.6, 'sawtooth', 0.22); noise(0.5, 0.15); },
    bossAppear: () => { sweep(80, 300, 0.8, 'square', 0.2); },
    bossDefeat: () => { sweep(120, 700, 1.0, 'sawtooth', 0.22); noise(0.6, 0.2); },
    caseOpen: () => { tone(400, 0.08, 'square', 0.12); tone(600, 0.08, 'square', 0.1, 0.1); tone(900, 0.15, 'square', 0.12, 0.2); },
    click: () => tone(500, 0.04, 'square', 0.08),
    gameOver: () => sweep(400, 60, 1.0, 'sawtooth', 0.18),
  };

  const melody = [392, 440, 494, 440, 392, 330, 392, 494, 523, 494, 440, 392, 330, 294, 330, 392];
  function musicTick() {
    if (muted) { musicStep++; return; }
    const f = melody[musicStep % melody.length];
    tone(f / 2, 0.18, 'triangle', 0.045);
    if (musicStep % 4 === 0) tone(f / 4, 0.3, 'square', 0.03);
    musicStep++;
  }
  function startMusic() {
    if (musicTimer) return;
    ctxReady();
    musicTimer = setInterval(musicTick, 220);
  }
  function stopMusic() {
    if (musicTimer) { clearInterval(musicTimer); musicTimer = null; }
  }

  function setMuted(m) { muted = m; }
  function isMuted() { return muted; }

  return { sfx, startMusic, stopMusic, setMuted, isMuted, ctxReady };
})();

/* ---------------------------------------------------------
   SAVE / STORAGE
--------------------------------------------------------- */
const DEFAULT_SAVE = () => ({
  money: 0,
  highScore: 0,
  inventory: ['default'],
  equipped: 'default',
});
let save = DEFAULT_SAVE();

async function loadSave() {
  try {
    const res = await window.storage.get('pineapple_save', false);
    if (res && res.value) {
      const parsed = JSON.parse(res.value);
      save = Object.assign(DEFAULT_SAVE(), parsed);
      if (!save.inventory.includes('default')) save.inventory.unshift('default');
    }
  } catch (e) { /* first run — keep defaults */ }
}

async function persistSave() {
  try { await window.storage.set('pineapple_save', JSON.stringify(save), false); }
  catch (e) { /* best effort */ }
}

